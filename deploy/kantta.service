[Unit]
Description=Kantta account book
After=network.target

[Service]
Type=simple
User=opc
Group=opc
WorkingDirectory=/srv/kantta
Environment=KANTTA_BASE=/kantta/
ExecStart=/usr/bin/php -S 127.0.0.1:8109 -t showroom showroom/index.php
Restart=on-failure
RestartSec=2

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/kantta
MemoryDenyWriteExecute=false

[Install]
WantedBy=multi-user.target
