[Unit]
Description=Kantta, a wall of fractional executive seats
After=network.target

[Service]
Type=simple
WorkingDirectory=/srv/kantta
Environment=KANTTA_BASE=/kantta/
ExecStart=/usr/bin/php -S 127.0.0.1:8109 -t showroom showroom/index.php
Restart=always
RestartSec=5
User=opc

[Install]
WantedBy=multi-user.target
